<%- include('includes/header.ejs') %>
	<link rel="stylesheet" type="text/css" href="/css/product.css" />

	<body>
		<div class="products-container">
			<div class="navigation-menu">
				<ul class="nav justify-content-center">
					<li class="nav-item">
						<a class="nav-link active" href="/admin/">Home</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="/admin/product/all">Cars</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" href="/admin/user/all">Users</a>
					</li>
					<li class="nav-item" onclick="return confirm('Do you want to logout?')">
						<a class="nav-link" href="/admin/logout">Logout</a>
					</li>
				</ul>
			</div>

			<div class="restaurant-menu-frame">
				<div class="board">
					<div class="dishes-table">
						<span class="new-dish-txt"
							style="margin-bottom: 30px; display: block; text-align: center; font-size: 30px;">
							Car List
						</span>
						<table class="table table-bordered table-hover">
							<thead class="thead-light">
								<tr>
									<th scope="col">T/r</th>
									<th scope="col">Car Name</th>
									<th scope="col">Car Condition</th>
									<th scope="col">Car Category</th>
									<th scope="col">Car Collection</th>
									<th scope="col">Car Mileage</th>
									<th scope="col">Car Price</th>
									<th scope="col">Car Year</th>
									<th scope="col">Status</th>
								</tr>
							</thead>

							<% products.map(function(value, key){ %>
								<tbody>
									<tr>
										<td>
											<%= key + 1%>
										</td>
										<td>
											<%= value.productName%>
										</td>
										<td>
											<%= value.productCondition%>
										</td>
										<td>
											<%= value.productCategory%>
										</td>
										<td>
											<%= value.productCollection%>
										</td>
										<td>
											<%= value.productMileage%>
										</td>
										<td>
											<%= value.productPrice%>
										</td>
										<td>
											<%= value.productYear%>
										</td>
										<td>
											<select class="spec-select new-product-status" id="<%=value._id%>">
												<option value="PAUSE" <%=value.productStatus==='PAUSE' ? 'selected' : '' %>>PAUSE</option>
												<option value="ACTIVE" <%=value.productStatus==='ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
												<option value="DELETE" <%=value.productStatus==='DELETE' ? 'selected' : '' %>>DELETE</option>
											</select>
										</td>
									</tr>
								</tbody>
								<% }) %>
						</table>

						<div class="long-input" style="display: flex; justify-content: flex-end; margin-bottom: 25px">
							<button class="btn btn-primary" id="process-btn">New Car</button>
						</div>
					</div>

					<!-- FORM QISMI -->
					<form onsubmit="return validateForm()" action="/admin/product/create" method="POST" class="dish-container"
						enctype="multipart/form-data">
						<div class="long-input" style="display: flex; align-items: center; justify-content: center;">
							<span class="new-dish-txt" style="font-size: 25px;">NEW CAR DETAIL</span>
						</div>

						<div class="login-input-frame">
							<div class="long-input">
								<label>Car Name</label>
								<input type="text" placeholder="Name" name="productName" class="product-name" />
							</div>
							<input name="productStatus" value="PAUSE" class="product-status" hidden />
						</div>

						<div class="half-input-frame">
							<div class="half-input">
								<label>Car Price</label>
								<input type="number" placeholder="Price" name="productPrice" class="product-price" />
							</div>

							<div class="half-input">
								<label>Car Milaege</label>
								<input type="number" placeholder="Mileage" name="productMileage" class="product-mileage" />
							</div>
							<div class="half-input">
								<label>Car Year</label>
								<input type="number" placeholder="Year" name="productYear" class="product-year" />
							</div>
						</div>

						<div class="half-input-frame">
							<div class="half-input">
								<label>Product Collection</label>
								<select class="product-collection" name="productCollection">
									<option value="SEDAN" selected>SEDAN</option>
									<option value="TRUCK">TRUCK</option>
									<option value="SPORT_CAR">SPORT_CAR</option>
									<option value="HATCHBACK">HATCHBACK</option>
									<option value="OTHER">Other</option>
								</select>
							</div>

							<div class="half-input">
								<label>Car Condition</label>
								<select class="product-size" name="productCondition">
									<option value="NEW" selected>NEW</option>
									<option value="USED">USED</option>
									<option value="REFURBISHED">REFURBISHED</option>
								</select>
							</div>
							<div class="half-input">
								<label>Car Category</label>
								<select class="product-size" name="productCategory">
									<option value="GASOLINE" selected>GASOLINE</option>
									<option value="DIESEL">DIESEL</option>
									<option value="ELECTRIC">ELECTRIC</option>
									<option value="LPG">LPG</option>
									<option value="OTHER">Other</option>
								</select>
							</div>
						</div>

						<div class="long-input">
							<label>Car Description</label>
							<textarea name="productDesc" class="product-desc" rows="3"></textarea>
						</div>

						<div class="img-frame">
							<label>Product Images</label>
							<div class="media-frame">
								<div class="upload-img-box">
									<img src="/img/upload.svg" class="1" id="image-section-1" />
									<input type="file" id="file" name="productImages" class="image-one" required
										onchange="previewFileHandler(this, 1)" />
								</div>
								<div class="upload-img-box">
									<img src="/img/upload.svg" class="2" id="image-section-2" />
									<input type="file" id="file" name="productImages" class="image-two"
										onchange="previewFileHandler(this, 2)" />
								</div>
								<div class="upload-img-box">
									<img src="/img/upload.svg" class="3" id="image-section-3" />
									<input type="file" id="file" name="productImages" class="image-three"
										onchange="previewFileHandler(this, 3)" />
								</div>
								<div class="upload-img-box">
									<img src="/img/upload.svg" class="4" id="image-section-4" />
									<input type="file" id="file" name="productImages" class="image-four"
										onchange="previewFileHandler(this, 4)" />
								</div>
								<div class="upload-img-box">
									<img src="/img/upload.svg" class="5" id="image-section-5" />
									<input type="file" id="file" name="productImages" class="image-five"
										onchange="previewFileHandler(this, 5)" />
								</div>
								<input name="restaurantIid" class="restaurant-id" hidden />
							</div>
						</div>
						<div class="operation-buttons"
							style="margin-top: 30px; display: flex; justify-content: flex-end; gap: 10px;">
							<button type="button" class="btn btn-danger" id="cancel-btn">Cancel</button>
							<button type="submit" class="btn btn-success" id="create-btn">Create Car</button>
						</div>
					</form>
				</div>
			</div>
		</div>

		<!-- JS KODLARINI CHAQRISH -->
		<script type="text/javascript" src="/js/home.js"></script>
		<script type="text/javascript" src="/js/products.js"></script>
	</body>

	<%- include('includes/footer') %>