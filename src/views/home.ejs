<%- include('includes/header') %>

	<link rel="stylesheet" type="text/css" href="/css/home.css" />

	<!-- ZARURIY KUTUBXONALAR -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
	<!-- Three.js eski versiyasi (Koddagi ParticleSystem ishlashi uchun shart) -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r68/three.min.js"></script>
	<!-- TweenMax (GSAP) animatsiya uchun -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/1.18.0/TweenMax.min.js"></script>

	<body>
		<div class="home-container">
			<div class="navigation-menu">
				<ul class="nav justify-content-center">
					<li class="nav-item">
						<a class="nav-link active" href="/admin">Home</a>
					</li>
					<% if(!member) { %>
						<li class="nav-item">
							<a class="nav-link" href="/admin/signup">Signup</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="/admin/login">Login</a>
						</li>
						<% } else { %>
							<li class="nav-item">
								<a class="nav-link" href="/admin/product/all">Menu</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="/admin/user/all">Users</a>
							</li>
							<li class="nav-item" onclick="return confirm('Do you want to logout?')">
								<a class="nav-link" href="/admin/logout">Logout</a>
							</li>
							<% } %>
				</ul>
			</div>

			<!-- Animatsiya konteyneri (JS kodi buni avtomat to'ldiradi) -->
		</div>

		<!-- SIZNING YANGI JS KODINGIZ (Three.js kodi) -->
		<script type="text/javascript" src="/js/home.js"></script>
	</body>

	<%- include('includes/footer') %>