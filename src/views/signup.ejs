<%- include('includes/header') %>
	<link rel="stylesheet" type="text/css" href="/css/signup.css" />

	<body>

		<div class="form-container sign-up">

			<div class="navigation-menu">
				<ul class="nav justify-content-center">
					<li class="nav-item">
						<a class="nav-link active" href="/admin">Home</a>
					</li>
					<% if (!member) { %>
						<li class="nav-item">
							<a class="nav-link" href="/admin/signup">Signup</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="/admin/login">Login</a>
						</li>
						<% } else { %>
							<li class="nav-item">
								<a class="nav-link" href="/admin/product/all">Menu</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="/admin/user/all">Users</a>
							</li>
							<li class="nav-item" onclick="return confirm('Do you want to logout?')">
								<a class="nav-link" href="/admin/logout">Logout</a>
							</li>
							<% } %>
				</ul>
			</div>

			<form class="signup-container" onsubmit="return validateSignupForm()" action="/admin/signup" method="POST"
				enctype="multipart/form-data">

				<h1>Create Account</h1>

				<p class="signup-desc">
					Create your account and start managing your luxury showroom experience.
				</p>

				<input type="text" name="memberNick" class="member-nick" placeholder="Enter your username" required />

				<input type="text" name="memberPhone" class="member-phone" placeholder="Enter your phone number" required />

				<input type="password" name="memberPassword" class="member-password" placeholder="Enter your password"
					required />

				<input type="password" name="confirmPassword" class="confirm-password" placeholder="Repeat your password"
					required />

				<div class="signup-input-frame">
					<div class="media-frame">

						<img class="upload-img-frame" id="upload-img-preview" src="/img/default.jpeg" alt="Profile preview" />

						<div class="upload-container">
							<div class="media-text">Profile Image</div>

							<div class="file-box">
								<input class="upload-name" value="Choose image" disabled id="file-name-display" />

								<label for="input-file" class="file-input-label">Upload</label>

								<input type="file" id="input-file" class="upload-hidden member-image" name="memberImage"
									accept="image/*" />
							</div>

							<p class="thumbnail-desc">Upload JPG, JPEG or PNG image only.</p>
						</div>

					</div>
				</div>

				<input type="hidden" name="memberType" value="RESTAURANT" />

				<button class="signup-btn" name="signup" type="submit">
					Create Account
				</button>

				<div class="social-icons">
					<a href="#" class="icon"><i class="fa-brands fa-facebook-f"></i></a>
					<a href="#" class="icon"><i class="fa-brands fa-google"></i></a>
					<a href="#" class="icon"><i class="fa-brands fa-apple"></i></a>
				</div>

				<div class="signup-text">
					Already have an account? <b><a href="/admin/login">Log in</a></b>
				</div>

			</form>

		</div>

		<script src="/js/signup.js"></script>

	</body>

	<%- include('includes/footer') %>