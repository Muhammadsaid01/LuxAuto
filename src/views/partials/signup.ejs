<link rel="stylesheet" type="text/css" href="/css/signup.css" />
<div class="form-container sign-up">
	<form onsubmit="return validateSignupForm()" action="/admin/signup" method="POST" enctype="multipart/form-data">
		<h1>Create Account</h1>
		<div class="social-icons">
			<a href="#" class="icon"><i class="fa-brands fa-google-plus-g"></i></a>
			<a href="#" class="icon"><i class="fa-brands fa-facebook-f"></i></a>
			<a href="#" class="icon"><i class="fa-brands fa-github"></i></a>
			<a href="#" class="icon"><i class="fa-brands fa-linkedin-in"></i></a>
		</div>
		<span>or use your phone number for registeration</span>
		<input type="text" name="memberNick" class="member-nick" placeholder="Username" value="" />
		<input type="text" name="memberPhone" class="member-phone" placeholder="Phone" value="" />
		<input type="password" name="memberPassword" class="member-password" placeholder="Password" value="" />
		<input type="password" name="confirmPassword" class="confirm-password" placeholder="Repeat password" value="" />

		<div class="signup-input-frame">
			<div class="media-frame">
				<!-- Preview uchun ID qo'shildi (script ishlashi uchun) -->
				<img class="upload-img-frame" id="upload-img-preview" src="/img/default.jpeg" />
				<div class="upload-container">
					<span class="media-text">Product image</span>
					<div class="file-box bs3-primary preview-image" style="margin-top: 25px; display: flex">
						<input class="upload-name" value="Choose image" disabled="disabled" id="file-name-display" />
						<label for="input-file" class="file-input-label">Upload Image</label>
						<input type="file" id="input-file" class="upload-hidden form-control-file member-image" name="memberImage"
							accept="image/*" />
					</div>
					<p class="thumbnail-desc">
						Please upload restaurant image.<br />
						Attention only: .jpg, .jpeg, or .png. <br />
						formats allowed!
					</p>
				</div>
			</div>
		</div>

		<input name="memberType" value="RESTAURANT" hidden />
		<button class="signup-btn btn" name="signup" type="submit">Sign Up</button>
	</form>
</div>

<script src="/js/signup.js"></script>