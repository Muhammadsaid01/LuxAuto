<link rel="stylesheet" type="text/css" href="/css/login.css" />
<div class="form-container sign-in">
	<form class="login-container" action="/admin/login" METHOD="POST">
		<h1>Sign In</h1>
		<div class="social-icons">
			<a href="#" class="icon"><i class="fa-brands fa-google-plus-g"></i></a>
			<a href="#" class="icon"><i class="fa-brands fa-facebook-f"></i></a>
			<a href="#" class="icon"><i class="fa-brands fa-github"></i></a>
			<a href="#" class="icon"><i class="fa-brands fa-linkedin-in"></i></a>
		</div>
		<span>or use your email password</span>
		<input type="text" name="memberNick" class="member-nick" placeholder="Username" required />
		<input type="password" name="memberPassword" class="member-password" placeholder="Password" required />
		<a href="#">Forget Your Password?</a>
		<button class="login-btn btn" name="login" type="submit">Sign In</button>
	</form>
</div>

<script src="/js/login.js"></script>